programa {
  funcao inicio() {
    real _1, _2, multiplicacao, divisao, sub
    //declarando as variavel
    escreva("Digite o num 1: ")
    //armazenando o número que o user quiser
    leia(_1)
    // buscando a variavel
    escreva("Digte o num 2: ")
    //armazenando o número que o user quiser
    leia(_2)
     // buscando a variavel

    multiplicacao = _1 * _2
    divisao = _1 / _2
    sub = _1 - _2 
    //calculando as contas com os números que o user sugerir

    escreva("sua multipliação deu o resultade de : ", multiplicacao )
    //resultado da multiplicação
    escreva("\nsua divisão é : ", divisao)
    // o \n ajuda para corta a linha
    escreva("\nsua subtração é : ", sub)
    // resultado da subtração 

  }
}
