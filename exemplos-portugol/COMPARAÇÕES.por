programa {
  funcao inicio() {
    inteiro a,b
    escreva("digite algum valor: ")
    leia(a)
    escreva("Digite um valor difrente: ")
    leia()

    escreva("comparações:\n" )
    escreva("a > b =", (a > b), "\n")
    escreva("a < b =", (a < b), "\n")
    escreva("a != b =", (a != b), "\n")
    escreva("a == b =", (a == b), "\n")


  }
}
